# 统一换行：仓库内一律 LF，二进制文件不做转换
* text=auto eol=lf

# Shell 脚本与容器/应用配置必须是 LF，否则在 Linux 上会报 \r 错误
*.sh    text eol=lf
fnos/cmd/*      text eol=lf
fnos/config/*   text eol=lf
fnos/manifest   text eol=lf
*.conf  text eol=lf
*.tpl   text eol=lf
Dockerfile      text eol=lf
docker-compose*.yaml text eol=lf

# Windows 批处理需要 CRLF，否则个别 label/goto 会异常
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.fpk binary
